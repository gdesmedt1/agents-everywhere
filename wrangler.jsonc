{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "agents-everywhere",
	"account_id": "4f7e5d275bbcec61dbe60d03f7e9e159",
	"compatibility_date": "2026-09-11",
	"compatibility_flags": ["nodejs_compat", "nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "agents-everywhere",
			"database_id": "0b0302c9-99a7-4d17-8bf8-8dfe278d8676",
			"migrations_dir": "drizzle"
		}
	],
	"vars": {
		"ORIGIN": "https://agents-everywhere.gdesmedt1.workers.dev"
	}
}
