{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "my",
	"account_id": "a412200d80556eb87aeacf16cacb79f5",
	"compatibility_date": "2026-09-11",
	"compatibility_flags": ["nodejs_compat", "nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "agents-everywhere",
			"database_id": "bc43a0ef-d076-461b-ab04-ebb0b3d28f6c",
			"migrations_dir": "drizzle"
		}
	],
	"vars": {
		"ORIGIN": "https://my.assumption-alarm.workers.dev"
	}
}
