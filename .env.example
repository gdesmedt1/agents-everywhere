# Public site URL (no trailing slash). Local: http://localhost:5173
# Copy to .env and .dev.vars
ORIGIN="http://localhost:5173"

# Better Auth (≥32 chars)
BETTER_AUTH_SECRET="replace-with-a-long-random-secret-please"

# Google OAuth (Web application client)
# Redirect URI: ${ORIGIN}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenAI
OPENAI_API_KEY=""
# Optional: hosted ChatKit workflow. Leave empty to use Agents SDK stream UI.
OPENAI_CHATKIT_WORKFLOW_ID=""
OPENAI_CHATKIT_DOMAIN_KEY="domain_pk_localhost"

# Telegram
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""

# Cloudflare D1 (for drizzle-kit push / remote migrate)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_DATABASE_ID=""
CLOUDFLARE_D1_TOKEN=""
